# === Smart Logistics Backend — Environment Template ===
# Copy to backend/.env and fill in real values. backend/.env is gitignored.
# All variables are read by app/config.py (pydantic-settings).

# --- Database (Supabase Postgres) ---
# psycopg2 dialect is used (requirements.txt includes psycopg2-binary).
# For Supabase, prefer the transaction/pooler URL under high load:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# --- App ---
DEBUG=false
APP_NAME=Smart Logistics API
APP_VERSION=1.0.0
# Comma-separated list of allowed browser origins (CORS). Keep localhost for
# dev and add your production frontend URL (e.g. https://app.vercel.app).
CORS_ORIGINS=http://localhost:3000,https://CHANGE_ME.vercel.app

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Demo / Routing ---
# Set DEMO_MODE=true ONLY for local testing (bypasses auth).
DEMO_MODE=false
# OSRM public endpoint (free, rate-limited). For production use a hosted OSRM/Mapbox.
OSRM_BASE_URL=http://router.project-osrm.org
